@let(focusRing =
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-dark')
{{-- Voile : un toucher ferme le menu --}}
<div
  class="sm:hidden fixed inset-0 z-50 bg-ink/55"
  x-show="isVisible"
  x-cloak
  x-transition.opacity.duration.200ms
  @click="close()"
></div>
{{-- Tiroir --}}
<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Menu principal"
  class="sm:hidden fixed inset-y-0 right-0 z-50 w-[87%] max-w-sm bg-page shadow-2xl flex flex-col"
  x-show="isVisible"
  x-cloak
  x-transition:enter="transition-transform duration-200 ease-out"
  x-transition:enter-start="translate-x-full"
  x-transition:enter-end="translate-x-0"
  x-transition:leave="transition-transform duration-200 ease-in"
  x-transition:leave-end="translate-x-full"
  @keydown.escape.window="close()"
>
  <div class="flex items-center justify-between px-4 py-3 bg-white border-b border-line">
    <a
      href="{{ urlFor('home.index') }}"
      class="text-2xl uppercase border-y-2 border-accent py-1 tracking-wide text-ink {{ focusRing }}"
    >
      Loca<span class="text-accent">van</span>
    </a>
    <button
      type="button"
      x-ref="burgerClose"
      class="w-11 h-11 rounded-lg bg-line/40 active:bg-line/70 flex items-center justify-center text-ink text-lg cursor-pointer {{ focusRing }}"
      aria-label="Fermer le menu"
      @click="close()"
    >
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
  </div>
  @if(auth.isAuthenticated)
    <div class="flex items-center gap-3 p-4 bg-white border-b border-line">
      <img
        class="w-10 h-10 rounded-full object-cover"
        src="{{ await driveUrl(auth.user.avatarPath) }}"
        alt=""
      />
      <div class="flex flex-col">
        <span class="text-[15px] font-semibold text-ink">{{ auth.user.fullName }}</span>
        @if(auth.user.isAdmin)
          <span class="text-xs text-muted">Administrateur</span>
        @end
      </div>
    </div>
  @end

  <div class="flex-1 overflow-y-auto px-4 pt-4 pb-4">
    <p class="{{ sectionTitle }}">Navigation</p>
    <ul>
      <li>
        <a
          href="{{ urlFor('home.index') }}"

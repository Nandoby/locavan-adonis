@let(linkBase =
  'flex items-center gap-3.5 h-12 px-3 rounded-lg text-base active:bg-line/70 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent-dark')
@let(linkIdle = linkBase + ' text-muted-dark')
@let(linkActive = linkBase + ' font-semibold text-ink bg-line/40')
@let(sectionTitle =
  'text-[11px] font-semibold uppercase tracking-[0.14em] text-muted px-3 pb-2')

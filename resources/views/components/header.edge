@let(variant = $props.get('variant', 'solid'))
@let(isTransparent = variant === 'transparent')
@let(currentPath = request.url())
@let(isHomeActive = currentPath === '/')
@let(isVehiclesActive = currentPath.startsWith('/vehicles') || currentPath === '/search')
@let(navTextClass = isTransparent ? 'text-white' : 'text-muted-dark')
@let(activeExtra = isTransparent ? 'font-bold' : 'font-semibold text-ink')

<header
  class="{{
    isTransparent
      ? 'absolute inset-x-0 top-0 z-20'
      : 'relative bg-white border-b border-line'
  }}"
>
  <nav class="container mx-auto flex items-center gap-9 px-4 py-4" x-data="burger">
    <a
      href="{{ urlFor('home.index') }}"
      class="text-2xl uppercase border-y-2 border-accent py-1 tracking-wide {{ isTransparent ? 'text-white' : 'text-ink' }}"
    >
      Loca<span class="text-accent">van</span>
    </a>

    <ul class="hidden sm:flex items-center gap-6 text-[15px] {{ navTextClass }}">
      <li>
        <a
          href="{{ urlFor('home.index') }}"
          class="tracking-wide linkanimate {{ isHomeActive ? 'active ' + activeExtra : '' }}"
        >
          Accueil
        </a>
      </li>
      <li>
        <a
          href="{{ urlFor('vehicles.index') }}"
          class="tracking-wide linkanimate {{ isVehiclesActive ? 'active ' + activeExtra : '' }}"
        >
          Nos véhicules
        </a>
      </li>
      @if(!auth.isAuthenticated)
        <li><a href="#" class="tracking-wide linkanimate">Devenir loueur</a></li>
      @end

      <li><a href="#" class="tracking-wide linkanimate">Aide</a></li>
    </ul>

    <div
      class="ml-auto flex items-center gap-4 text-[15px] {{ isTransparent ? 'text-white' : 'text-ink' }}"
    >
      @if(!auth.isAuthenticated)
        <span class="hidden sm:block">
          <a href="{{ urlFor('session.create') }}" class="font-medium tracking-wide linkanimate">
            Connexion
          </a>
        </span>
        <a
          href="{{ urlFor('new_account.create') }}"
          class="bg-accent text-ink font-semibold px-5 py-2.5 rounded-lg hover:bg-accent/80 transition-colors"
        >
          Inscription
        </a>
      @else
        <span class="hidden sm:block">
          @link({ route: 'vehicles.create', class: 'tracking-wide linkanimate' })
            Déposer une annonce
          @end
        </span>
        <div x-data="dropdown" class="relative hidden sm:block">
          <button
            id="dropdownDefault"
            class="group font-medium rounded-lg text-sm px-3 py-2 flex items-center gap-3 cursor-pointer {{ isTransparent ? 'hover:bg-white/10' : 'hover:bg-neutral-100' }}"
            type="button"
            @click="toggle()"
          >
            {{ auth.user.firstName }}
            {{ auth.user.lastName }}
            <span class="relative">
              <img
                class="w-10 h-10 rounded-full"
                src="{{ await driveUrl(auth.user.avatarPath) }}"
                alt="avatar image"
              />
              @if(pendingBookingsCount > 0)
                <span
                  class="absolute -top-1 -right-1 bg-accent text-ink text-xs font-semibold rounded-full min-w-5 h-5 px-1 flex items-center justify-center"
                >
                  {{ pendingBookingsCount }}
                </span>
              @end
            </span>
            <i class="fa-solid" :class="dropped ? 'fa-chevron-up' : 'fa-chevron-down'"></i>
          </button>
          <div
            x-show="dropped"
            id="dropdown"
            class="z-10 bg-white text-gray-700 rounded shadow w-54 absolute right-0 mt-3 overflow-hidden border border-line"
          >
            <ul class="text-sm divide-y divide-gray-200">
              <li>
                <a href="{{ urlFor('profile') }}" class="dropdown-item">
                  <i class="fa-solid fa-user w-6"></i>Modifier profil
                </a>
              </li>
              <li>
                <a href="{{ urlFor('bookings.bookings') }}" class="dropdown-item">

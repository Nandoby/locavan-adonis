                </a>
              </li>
              <li>
                <a href="{{ urlFor('vehicles.listing') }}" class="dropdown-item">
                  <i class="fa-solid fa-book-open w-6"></i>Mes annonces
                </a>
              </li>
              <li>
                <a href="{{ urlFor('bookings.received') }}" class="dropdown-item">
                  <i class="fa-solid fa-inbox w-6"></i>
                  
                  Réservations reçues

                  @if(pendingBookingsCount > 0)
                    <span
                      class="ml-auto bg-accent text-ink text-xs font-semibold rounded-full min-w-5 h-5 px-1 flex items-center justify-center"
                    >
                      {{ pendingBookingsCount }}

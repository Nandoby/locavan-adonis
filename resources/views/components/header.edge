              <li>
                @form({ route: 'session.destroy', method: 'POST' })
                  @button({
                    class:
                      'flex items-center w-full dropdown-item cursor-pointer bg-gray-200 hover:bg-gray-300',
                  })
                    <i class="fa-solid fa-arrow-right-from-bracket w-6"></i>
                    <span>Déconnexion</span>
                  @end
                @end
              </li>
            </ul>
          </div>
        </div>
      @end

      <span class="sm:hidden cursor-pointer" @click="toggle()">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-7 w-7 stroke-accent"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />

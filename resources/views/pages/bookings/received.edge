@layout({ title: 'Réservations reçues' })
  <section>
    <div class="container mx-auto px-4">
      <h1 class="font-medium text-3xl my-4">Réservations reçues</h1>

      <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
        <table class="w-full text-sm text-left text-gray-500">
          <thead class="text-xs text-gray-700 uppercase bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3">Annonce</th>
              <th scope="col" class="px-6 py-3">Locataire</th>
              <th scope="col" class="px-6 py-3">Du</th>
              <th scope="col" class="px-6 py-3">Au</th>
              <th scope="col" class="px-6 py-3">Nuits</th>
              <th scope="col" class="px-6 py-3">Total</th>
              <th scope="col" class="px-6 py-3">Statut</th>
              <th scope="col" class="px-6 py-3">Actions</th>
            </tr>
          </thead>
          <tbody>
            @each(book in bookings)
              <tr class="border-b odd:bg-white">
                <td class="px-6 py-4">{{ book.vehicle.type.name }} {{ book.vehicle.model }}</td>
                <td class="px-6 py-4">{{ book.user.firstName }} {{ book.user.lastName }}</td>
                <td class="px-6 py-4">{{ book.startDate.toFormat('dd/MM/yyyy') }}</td>
                <td class="px-6 py-4">{{ book.endDate.toFormat('dd/MM/yyyy') }}</td>
                <td class="px-6 py-4">{{ book.nights }}</td>
                <td class="px-6 py-4">{{ book.totalPrice.toFixed(2) }} €</td>
                <td class="px-6 py-4">
                  @if(book.status === 'pending')
                    <span
                      class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded"
                    >
                      En attente
                    </span>
                  @elseif(book.status === 'confirmed')
                    <span
                      class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded"
                    >
                      Confirmée
                    </span>
                  @elseif(book.status === 'declined')
                    <span class="bg-red-100 text-red-800 text-xs font-medium px-2.5 py-0.5 rounded">
                      Refusée
                    </span>
                  @else
                    <span
                      class="bg-gray-200 text-gray-700 text-xs font-medium px-2.5 py-0.5 rounded"
                    >
                      Annulée
                    </span>
                  @end
                </td>
                <td class="px-6 py-4">
                  @if(book.status === 'pending')
                    <div class="flex items-center gap-3">
                      <form method="POST" action="{{ urlFor('bookings.accept', [book.id]) }}">
                        {{ csrfField() }}
                        <button
                          type="submit"
                          class="font-medium text-green-600 hover:underline cursor-pointer"
                        >
                          Accepter
                        </button>
                      </form>
                      <form
                        method="POST"
                        action="{{ urlFor('bookings.decline', [book.id]) }}"
                        onsubmit="return confirm('Refuser cette demande de réservation ?')"
                      >
                        {{ csrfField() }}
                        <button
                          type="submit"
                          class="font-medium text-red-600 hover:underline cursor-pointer"
                        >
                          Refuser
                        </button>
                      </form>
                    </div>
                  @else
                    <span class="text-gray-400">—</span>
                  @end
                </td>
              </tr>
            @else
              <tr>
                <td class="px-6 py-4">Aucune demande de réservation sur vos annonces</td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    </div>
  </section>
@end

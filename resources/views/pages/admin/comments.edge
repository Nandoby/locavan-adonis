@admin.layout()
  <main>
    <div class="flex flex-col md:flex-row">
      @include('partials/admin/nav')
      <section class="w-full">
        <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
          <table class="w-full text-sm text-left text-gray-500 mt-28 mb-28">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50">
              <tr>
                <td class="px-6 py-4">#</td>
                <td class="px-6 py-4">Auteur</td>
                <td class="px-6 py-4">Commentaire</td>
                <td class="px-6 py-4">Note</td>
              </tr>
            </thead>
            <tbody>
              @each(comment in comments)
                <tr class="bg-white border-b">
                  <td class="px-6 py-4">{{ comment.id }}</td>
                  <td class="px-6 py-4">
                    {{ comment.user.firstName }}
                    {{ comment.user.lastName }}
                  </td>
                  <td class="px-6 py-4">{{ comment.content }}</td>
                  <td class="px-6 py-4">{{ comment.rating }}</td>
                </tr>
              @end
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>
@end

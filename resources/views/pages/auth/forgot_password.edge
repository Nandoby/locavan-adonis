@layout({ title: 'Mot de passe oublié' })
  <div class="h-screen flex">
    <img
      class="hidden lg:block md:w-6/12 object-cover"
      src="/images/login-background.webp"
      alt=""
    />
    <div class="flex justify-center items-center w-full lg:w-6/12">
      @form({ route: 'password_reset.store', method: 'POST' })
        <h1 class="text-3xl uppercase text-amber-600 drop-shadow-lg">
          <a href="{{ urlFor('home.index') }}">
            <span class="text-black border-y-2 border-y-amber-600">Loca</span>van
          </a>
        </h1>
        <h3 class="my-3 text-gray-800">Mot de passe oublié</h3>
        <p class="mb-4 text-sm text-gray-500 max-w-sm">
          Indiquez l'adresse e-mail de votre compte : nous vous enverrons un lien pour choisir un nouveau mot de passe.
        </p>
        <div class="mb-3">
          @field.root({ name: 'email' })
            @!field.label({ text: 'E-mail', class: 'block mb-3 text-gray-500 text-sm' })
            @!input.control({
              type: 'email',
              class:
                'border border-gray-300 p-2 w-full text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-dark rounded shadow',
            })
            @!field.error()
          @end
        </div>
        @!button({
          text: 'Envoyer le lien',
          type: 'submit',
          class:
            'bg-amber-600 text-white font-medium p-4 tracking-tight rounded hover:bg-amber-700 transition duration-150 cursor-pointer',
        })
        <p class="text-sm mt-4">
          <a
            href="{{ urlFor('session.create') }}"
            class="underline text-yellow-600 hover:text-yellow-800"
          >
            Retour à la connexion
          </a>
        </p>
      @end
    </div>
  </div>
@end

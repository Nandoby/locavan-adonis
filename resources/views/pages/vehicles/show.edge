@let(isOwner = auth.user && auth.user.id === vehicle.user.id)
@layout({ title: vehicle.model })
  @if(vehicle.status !== 'published' && isOwner)
    <div class="bg-yellow-100 text-yellow-800 text-center py-2 text-sm">
      Cette annonce n'est pas visible publiquement ({{ vehicle.status === 'paused' ? 'en pause' : 'brouillon' }}).
    </div>
  @end

  <main class="bg-page">
    <div class="container mx-auto px-4 py-6">
      <!--Fil d'Ariane-->
      <div class="flex items-center gap-2 text-xs text-muted-dark flex-wrap mb-3">
        <a

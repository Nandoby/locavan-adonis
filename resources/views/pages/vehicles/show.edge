              >
                <span class="text-[#A33232] font-bold">✕</span>
                Voyage à l'étranger non autorisé
              </div>
            @end
            @if(vehicle.animals)
              <div
                class="flex items-center gap-2 text-sm text-ink bg-[#F2F7F2] border border-[#C9DFC9] rounded-full px-3.5 py-2"
              >
                <span class="text-[#2E7A3E] font-bold">✓</span>

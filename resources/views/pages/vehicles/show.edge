          </span>
          <span
            class="text-sm text-muted-dark border border-line rounded-lg px-3.5 py-2.5 bg-white opacity-60 cursor-not-allowed"
            title="Partage — arrive avec une prochaine évolution"
          >
            <i class="fa-light fa-share"></i>
            Partager
          </span>
        </div>
      </div>
      <!--Galerie en mosaïque-->
      <div class="grid grid-cols-4 gap-1.5 sm:gap-2 rounded-2xl overflow-hidden mb-8">
        @each((picture, index) in vehicle.pictures.slice(0, 5))
          <a
            href="{{ await driveUrl(picture.path) }}"

              </div>
            @else
              <div
                class="flex items-center gap-2 text-sm text-ink bg-[#FBF2F2] border border-[#E7C9C9] rounded-full px-3.5 py-2"
              >
                <span class="text-[#A33232] font-bold">✕</span>
                Animaux non autorisés
              </div>
            @end

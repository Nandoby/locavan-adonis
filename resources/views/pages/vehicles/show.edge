                @if(vehicle.comments.length > 0)
                  <div class="flex items-center gap-2 text-sm text-muted-dark mt-1.5">
                    @!rating({ rating: ratingAverage })
                    <span class="font-semibold text-ink">{{ ratingAverage }} / 5</span>
                    <span>· {{ vehicle.comments.length }} avis</span>
                  </div>

            rel="noopener"
            class="relative block {{ index === 0 ? 'col-span-2 row-span-2' : 'aspect-square' }}"
          >
            <img
              class="w-full h-full object-cover"
              src="{{ await driveUrl(picture.path) }}"
              alt=""
            />
            @if(index === 4 && vehicle.pictures.length > 5)
              <span
                class="absolute inset-0 bg-ink/55 flex items-center justify-center text-white text-sm font-semibold"
              >
                Voir les
                {{ vehicle.pictures.length }}
                photos
              </span>
            @end
          </a>
        @end
      </div>

      <div class="grid md:grid-cols-[minmax(0,1fr)_360px] gap-8 items-start">
        <!--Colonne gauche-->
        <div class="flex flex-col gap-8 order-2 md:order-none">

                    @if(comment.memories.length > 0)
                      <div class="flex flex-wrap gap-2 mt-3">
                        @each(memory in comment.memories)
                          <a
                            href="{{ await driveUrl(memory.path) }}"
                            data-lightbox="image-{{ comment.id }}"
                            data-caption="{{ comment.user.fullName }} - {{ vehicle.type.name }} {{ vehicle.model }}"
                          >
                            <img
                              class="w-16 h-12 rounded-lg object-cover"
                              src="{{ await driveUrl(memory.path) }}"
                              alt=""

@layout()
  @include('partials/header')

  <main class="box-border">
    <div class="mx-auto p-0">
      <section class="container mx-auto mt-20 flex flex-col md:flex-row md:space-x-4 p-4">
        <!--Left Column-->
        <div class="w-12/12 md:w-6/12">
          <div class="splide" aria-label="Photos du véhicule">
            <div class="splide__track">
              <ul class="splide__list">
                @each(picture in vehicle.pictures)
                  <li class="splide__slide">
                    <img class="aspect-video object-cover w-full" src="{{ picture.path }}" alt="" />
                  </li>
                @end
              </ul>
            </div>
          </div>
          <div class="flex space-x-4">
            <img class="w-24 h-24" src="{{ vehicle.user.avatarPath }}" alt="avatar" />
            <div class="space-y-2">
              <h3 class="text-2xl font-semibold">
                {{ vehicle.type.name }}
                de
                {{ vehicle.user.fullName }}
              </h3>
              <p class="text-neutral-500">{{ vehicle.city }}</p>
              <div>
                @!rating({ rating: await vehicle.ratingAverage() })
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
@end

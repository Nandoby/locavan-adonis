                  <span class="text-2xl font-bold text-ink">{{ vehicle.price }} €</span>
                  <span class="text-sm text-muted">/ nuit</span>
                </p>
                @if(vehicle.comments.length > 0)
                  <p class="text-sm text-muted-dark">
                    <i class="fa-solid fa-star text-accent"></i>
                    <span class="font-semibold text-ink">{{ ratingAverage }}</span>
                    ({{ vehicle.comments.length }})
                  </p>
                @end
              </div>
              @form({
                route: 'bookings.store',
                method: 'POST',
                routeParams: vehicle,
                class: 'mt-4',
              })
                <div class="grid grid-cols-2 border border-line rounded-xl overflow-hidden">
                  @field.root({ name: 'booking_startDate' })
                    <div class="p-3 border-r border-line">
                      @!field.label({
                        text: 'Départ',
                        class:
                          'block text-[11px] font-semibold uppercase tracking-wide text-[#666D7D]',
                      })
                      @!input.control({
                        type: 'text',
                        class: 'mt-0.5 w-full text-[15px] focus:outline-none',
                        dataDatesDisabled: notAvailableDaysJson,
                        dataPrice: vehicle.price,
                      })
                      @!field.error()
                    </div>
                  @end
                  @field.root({ name: 'booking_endDate' })
                    <div class="p-3">
                      @!field.label({
                        text: 'Retour',
                        class:
                          'block text-[11px] font-semibold uppercase tracking-wide text-[#666D7D]',
                      })
                      @!input.control({
                        type: 'text',
                        class: 'mt-0.5 w-full text-[15px] focus:outline-none',
                      })
                      @!field.error()
                    </div>
                  @end
                </div>
                <p id="booking-summary" class="text-sm text-muted-dark mt-3" hidden></p>
                @!button({
                  type: 'submit',
                  class:
                    'w-full bg-accent hover:bg-accent/80 text-ink font-semibold text-[15px] text-center py-3.5 rounded-xl mt-3.5 cursor-pointer transition-colors',
                  text: 'Réserver',
                })
              @end

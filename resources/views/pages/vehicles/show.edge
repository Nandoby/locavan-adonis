@layout()
  @if(vehicle.status !== 'published' && auth.user && auth.user.id === vehicle.user.id)
    <div class="bg-yellow-100 text-yellow-800 text-center py-2 text-sm">
      Cette annonce n'est pas visible publiquement ({{ vehicle.status === 'paused' ? 'en pause' : 'brouillon' }}).
    </div>
  @end
  @include('partials/header')

  <main class="box-border">
    <div class="mx-auto p-0">
      <section class="container mx-auto mt-20 flex flex-col md:flex-row md:space-x-4 p-4">
        <!--Left Column-->
        <div class="w-12/12 md:w-6/12">
          <div class="splide" aria-label="Photos du véhicule">
            <div class="splide__track">
              <ul class="splide__list">
                @each(picture in vehicle.pictures)
                  <li class="splide__slide">
                    <img
                      class="aspect-video object-cover w-full"
                      src="{{ await driveUrl(picture.path) }}"
                      alt=""
                    />
                  </li>
                @end
              </ul>
            </div>
          </div>
          <div class="flex space-x-4">
            <img
              class="w-24 h-24"
              src="{{ await driveUrl(vehicle.user.avatarPath) }}"
              alt="avatar"
            />
            <div class="space-y-2">
              <h3 class="text-2xl font-semibold">
                {{ vehicle.type.name }}
                de
                {{ vehicle.user.fullName }}
              </h3>
              <p class="text-neutral-500">{{ vehicle.city }}</p>
              <div>
                @!rating({ rating: await vehicle.ratingAverage() })
              </div>
            </div>
          </div>
          <!--Informations générales-->
          <div class="icones">
            <div class="flex flex-col items-center text-center">
              <i class="fa-light fa-seat-airline text-4xl mb-4"></i>
              <p>
                <strong>{{ vehicle.seats }} places</strong>
                <span class="block"></span>
                sécurisées
              </p>
            </div>
            <div class="flex flex-col items-center text-center">
              <i class="fa-light fa-bed-front text-4xl mb-4"></i>
              <p>
                <strong>{{ vehicle.beds }} places</strong>
                <span class="block"></span>
                de couchage
              </p>
            </div>
            <div class="flex flex-col items-center text-center">
              <i class="fa-light fa-paw text-4xl mb-4"></i>
              <p>
                Animaux
                <span class="block"></span>
                <strong>{{ vehicle.animals ? 'autorisés' : 'non autorisés' }}</strong>
              </p>
            </div>
            <div class="flex flex-col items-center text-center">
              <i class="fa-light fa-earth-americas mb-4 text-4xl"></i>
              <p>
                Voyage à l'étranger
                <span class="block"></span>
                <strong>{{ vehicle.travelAbroad ? 'autorisé' : 'non autorisé' }}</strong>
              </p>
            </div>
          </div>
          <!--Caractéristiques techniques-->
          <div class="flex flex-col md:flex-row mt-8 gap-8">
            <div class="w-12/12 md:w-6/12">
              <h3 class="font-bold">Caractéristiques techniques</h3>
            </div>
            <div class="w-12/12 md:w-6/12">
              <p>Modèle : <strong>{{ vehicle.model }}</strong></p>
              <p>Mise en circulation : <strong>{{ vehicle.year }}</strong></p>
              <br />
              <p>Nombres de places assises : <strong>{{ vehicle.seats }}</strong></p>
              <p>Nombre de places de couchage : <strong>{{ vehicle.beds }}</strong></p>
              <br />
              <p>Longueur : <strong>{{ vehicle.length }} m</strong></p>
              <p>Largeur : <strong>{{ vehicle.width }} m</strong></p>
              <p>Hauteur : <strong>{{ vehicle.height }} m</strong></p>
              <br />
              <p>Eau propre : <strong>{{ vehicle.cleanWater }} l</strong></p>
              <p>Eaux usagées : <strong>{{ vehicle.wasteWater }} l</strong></p>
              <br />
              <p>Nombre de kilomètres : <strong>{{ vehicle.km }} km</strong></p>
            </div>
          </div>
        </div>
        <!--Right Column-->
        <div class="w-12/12 md:w-6/12 mt-8 md:mt-0">
          <div class="border border-neutral-300 rounded-lg bg-white">
            <h2 class="p-4 text-center text-xl bg-black text-white font-bold rounded-t-lg">
              Réservation
            </h2>
            @form({
              route: 'bookings.store',
              class: 'p-4',
              method: 'POST',
              routeParams: vehicle,
            })
              <div class="flex gap-2 mb-4">
                <div class="flex-1">
                  @field.root({ name: 'booking_startDate' })
                    @!field.label({
                      class: 'block',
                      text: 'Date de départ',
                    })
                    @!input.control({
                      type: 'text',
                      class:
                        'border border-neutral-300 rounded w-full p-2 focus:outline outline-amber-500',
                      dataDatesDisabled: notAvailableDaysJson,
                    })
                    @!field.error()
                  @end
                </div>
                <div class="flex-1">
                  @field.root({ name: 'booking_endDate' })
                    @!field.label({ text: 'Date de retour', class: 'block' })
                    @!input.control({
                      type: 'text',
                      class:
                        'border border-neutral-300 rounded w-full p-2 focus:outline outline-amber-500',
                    })
                  @end
                </div>
              </div>
              @!button({
                type: 'submit',
                class:
                  'w-full sm:w-4/12 bg-amber-500 hover:bg-amber-600 p-4 rounded-lg text-black font-semibold cursor-pointer',
                text: 'Réserver',
              })
            @end
          </div>
          <!--Description du véhicule-->
          <div class="mt-4 border border-neutral-300 rounded-lg p-4 bg-white">
            <h2 class="text-xl font-bold">Description</h2>
            <p class="mt-4 text-neutral-700 leading-relaxed">{{ vehicle.description }}</p>
          </div>
        </div>
      </section>
      <!--Avis location-->
      <section class="mt-8 bg-white">
        <div class="container mx-auto p-4">
          <h3 class="font-bold text-xl">Avis locataires</h3>
          <!--Votes-->
          @!rating({ rating: await vehicle.ratingAverage() })
          <span>|</span>
          {{ vehicle.comments.length }}
          <span>avis</span>
          <!--End Votes-->
          <div class="divide-y divide-slate-300 w-12/12 lg:w-6/12 mx-auto">
            @each(comment in vehicle.comments)
              <div class="my-8 flex gap-4 p-6 items-start">
                <img
                  class="rounded-lg w-16 h-16"
                  src="{{ await driveUrl(comment.user.avatarPath) }}"
                  alt=""
                />
                <div class="w-full">
                  <h5 class="font-medium">
                    {{ comment.user.firstName }}
                    {{ comment.user.lastName }}
                  </h5>
                  <p class="text-sm text-neutral-500 italic">
                    {{ comment.createdAt.toLocaleString() }}
                  </p>
                  <p class="font-light tracking-wide leading-relaxed">{{ comment.content }}</p>
                  @if(comment.memories.length > 0)
                    <div class="memories flex flex-wrap gap-4 mt-4">
                      @each(memory in comment.memories)
                        <a
                          href="{{ await driveUrl(memory.path) }}"
                          data-lightbox="image-{{ comment.id }}"
                          data-caption="{{ comment.user.fullName }} - {{ memory.createdAt.toLocaleString() }} - {{ vehicle.type.name }} - {{ vehicle.model }}"
                        >
                          <img
                            class="w-24 h-24 rounded-lg"
                            src="{{ await driveUrl(memory.path) }}"
                            alt=""
                          />
                        </a>
                      @end
                    </div>
                  @end
                </div>
              </div>
            @end
          </div>
        </div>
      </section>
      <!--End Avis location-->
    </div>
  </main>
@end

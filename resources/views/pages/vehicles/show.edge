          class="text-accent-dark font-medium hover:underline"
        >
          ← Retour aux résultats
        </a>
        <span>·</span>
        <a href="{{ urlFor('vehicles.index') }}" class="hover:underline">Nos véhicules</a>
        <span>·</span>
        <span>{{ vehicle.type.name }} à {{ vehicle.city }}</span>
        <span>·</span>
        <span class="text-ink font-medium">{{ vehicle.model }}</span>
      </div>
      <!--Titre-->
      <div class="flex items-start justify-between gap-4 flex-wrap mb-5">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold text-ink leading-tight">{{ vehicle.model }}</h1>

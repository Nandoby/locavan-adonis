@layout()
  @include('partials/header')
  <section>
    <div class="container mx-auto px-4">
      <h1 class="font-medium text-3xl my-4">Mes annonces</h1>

      <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
        <table class="w-full text-sm text-left text-gray-500">
          <thead class="text-xs text-gray-700 uppercase bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3">Modèle</th>
              <th scope="col" class="px-6 py-3">Type</th>
              <th scope="col" class="px-6 py-3">Km</th>
              <th scope="col" class="px-6 py-3">Date de création</th>
              <th scope="col" class="px-6 py-3">Prix</th>
              <th scope="col" class="px-6 py-3">Réservations</th>
              <th scope="col" class="px-6 py-3">Commentaires</th>
              <th scope="col" class="px-6 py-3">Status</th>
              <th scope="col" class="px-6 py-3">Actions</th>
            </tr>
          </thead>
          <tbody>
            @each(vehicle in vehicles)
              <tr class="border-b odd:bg-white">
                <td class="px-6 py-4">{{ vehicle.model }}</td>
                <td class="px-6 py-4">{{ vehicle.type.name }}</td>
                <td class="px-6 py-4">{{ vehicle.km }}</td>
                <td class="px-6 py-4">{{ vehicle.createdAt.toFormat('dd/MM/yyyy') }}</td>
                <td class="px-6 py-4">{{ vehicle.price.toFixed(2) }} € / jour</td>
                <td class="px-6 py-4 text-center">
                  <span
                    class="bg-purple-100 text-purple-800 text-sm font-medium mr-2 px-2.5 py-0.5 rounded"
                  >
                    {{ vehicle.$extras.bookings_count }}
                  </span>
                </td>
                <td class="px-6 py-4 text-center">
                  <span
                    class="bg-purple-100 text-purple-800 text-sm font-medium mr-2 px-2.5 py-0.5 rounded"
                  >
                    {{ vehicle.$extras.comments_count }}
                  </span>
                </td>
                <td class="px-6 py-4">
                  @if(vehicle.status === 'published')
                    <span
                      class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded"
                    >
                      En ligne
                    </span>
                  @elseif(vehicle.status === 'paused')
                    <span
                      class="bg-gray-200 text-gray-700 text-xs font-medium px-2.5 py-0.5 rounded"
                    >
                      En pause
                    </span>
                  @else
                    <span
                      class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded"
                    >
                      Brouillon
                    </span>
                  @end
                </td>
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <a
                      href="{{ urlFor('vehicles.edit', [vehicle.id]) }}"
                      class="font-medium text-blue-600 hover:underline"
                    >
                      Modifier
                    </a>
                    <form
                      method="POST"
                      action="{{ urlFor('vehicles.update_status', [vehicle.id]) }}"
                    >
                      {{ csrfField() }}
                      <input
                        type="hidden"
                        name="status"
                        value="{{ vehicle.status === 'published' ? 'paused' : 'published' }}"
                      />
                      <button
                        type="submit"
                        class="font-medium text-amber-600 hover:underline cursor-pointer"
                      >
                        {{ vehicle.status === 'published' ? 'Mettre en pause' : 'Publier' }}
                      </button>
                    </form>

                    <form
                      method="POST"
                      action="{{ urlFor('vehicles.destroy', [vehicle.id]) }}"
                      onsubmit="return confirm('Supprimer définitivement cette annonce ?')"
                    >
                      {{ csrfField() }}
                      <button
                        type="submit"
                        class="font-medium text-red-600 hover:underline cursor-pointer"
                      >
                        Supprimer
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            @else
              <tr>
                <td class="px-6 py-4">Aucune annonce ajoutée pour le moment</td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    </div>
  </section>
@end

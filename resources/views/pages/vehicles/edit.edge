@layout({ title: 'Modifier une annonce' })
  @include('partials/header')

  <section class="container mx-auto px-4">
    <h1 class="tracking-wide font-bold text-3xl text-center my-8">
      Modifier l'annonce :
      {{ vehicle.model }}
    </h1>
    @form({
      route: 'vehicles.update',
      routeParams: vehicle,
      method: 'POST',
      enctype: 'multipart/form-data',
      class: 'bg-white shadow p-4 mb-8',
    })
      <div class="grid gap-6 mb-6 lg:grid-cols-2">
        <div>
          @field.root({ name: 'model' })
            @!field.label({ text: 'Modèle', class: 'label' })
            @!input.control({ type: 'text', class: 'input-field', value: vehicle.model })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'type' })
            @!field.label({ text: 'Type', class: 'label' })
            @!select.control({
              options: types.map((type) => ({
                name: type.name,
                value: type.id,
                isSelected: type.id === vehicle.typeId,
              })),
              required: true,
              prompt: 'Choisissez un type',
              class: 'select',
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'price' })
            @!field.label({ text: 'Prix', class: 'label' })
            @!input.control({
              type: 'number',
              step: '0.10',
              class: 'input-field',
              value: vehicle.price,
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'year' })
            @!field.label({ text: 'Année', class: 'label' })
            @!input.control({
              type: 'number',
              step: '1',
              class: 'input-field',
              value: vehicle.year,
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'length' })
            @!field.label({ text: 'Longueur', class: 'label' })
            @!input.control({
              type: 'number',
              step: '0.1',
              class: 'input-field',
              value: vehicle.length,
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'height' })
            @!field.label({ text: 'Hauteur', class: 'label' })
            @!input.control({
              type: 'number',
              step: '0.1',
              class: 'input-field',
              value: vehicle.height,
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'width' })
            @!field.label({ text: 'Largeur', class: 'label' })
            @!input.control({
              type: 'number',
              step: '0.1',
              class: 'input-field',
              value: vehicle.width,
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'km' })
            @!field.label({ text: 'Km', class: 'label' })
            @!input.control({
              type: 'number',
              step: '0.1',
              class: 'input-field',
              value: vehicle.km,
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'city' })
            @!field.label({ text: 'Ville', class: 'label' })
            @!input.control({ type: 'text', class: 'input-field', value: vehicle.city })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'cleanWater' })
            @!field.label({ text: 'Eaux claires', class: 'label' })
            @!input.control({
              type: 'number',
              step: 1,
              class: 'input-field',
              value: vehicle.cleanWater,
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'wasteWater' })
            @!field.label({ text: 'Eaux usées', class: 'label' })
            @!input.control({
              type: 'number',
              step: 1,
              class: 'input-field',
              value: vehicle.wasteWater,
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'seats' })
            @!field.label({ text: 'Sièges', class: 'label' })
            @!input.control({
              type: 'number',
              step: 1,
              class: 'input-field',
              value: vehicle.seats,
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'beds' })
            @!field.label({ text: 'Couchages', class: 'label' })
            @!input.control({
              type: 'number',
              step: 1,
              class: 'input-field',
              value: vehicle.beds,
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'animals' })
            @!field.label({ text: 'Animaux autorisés', class: 'label' })
            @!select.control({
              class: 'select',
              prompt: 'Choisissez Oui ou Non',
              options: [
                { name: 'Oui', value: 1, isSelected: !!vehicle.animals },
                { name: 'Non', value: 0, isSelected: !vehicle.animals },
              ],
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'travelAbroad' })
            @!field.label({ text: "Voyages à l'étranger", class: 'label' })
            @!select.control({
              class: 'select',
              prompt: 'Choisissez Oui ou Non',
              options: [
                { name: 'Oui', value: 1, isSelected: !!vehicle.travelAbroad },
                { name: 'Non', value: 0, isSelected: !vehicle.travelAbroad },
              ],
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'description' })
            @!field.label({ text: 'Description', class: 'label' })
            @!textarea.control({
              rows: 4,
              class: 'textarea',
              value: vehicle.description,
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'pictures[]' })
            @!field.label({ text: 'Ajouter des photos (optionnel)', class: 'label' })
            @!input.control({ type: 'file', class: 'input-file', multiple: true })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
          @if(vehicle.pictures && vehicle.pictures.length)
            <div class="flex flex-wrap gap-2 mt-3">
              @each(picture in vehicle.pictures)
                <img
                  class="h-20 w-28 object-cover rounded border"
                  src="{{ await driveUrl(picture.path) }}"
                  alt=""
                />
              @end
            </div>
          @end
        </div>
      </div>
      @!button({
        text: 'Enregistrer les modifications',
        type: 'submit',
        class:
          'focus:outline-none text-white bg-yellow-400 hover:bg-yellow-500 focus:ring-4 focus:ring-yellow-300 font-medium rounded-lg text-sm px-5 py-2.5 mr-2 mb-2',
      })
    @end
  </section>
@end

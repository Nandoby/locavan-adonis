@layout({ title: 'Ajouter une annonce' })
  @include('partials/header')

  <section class="container mx-auto px-4">
    <h1 class="tracking-wide font-bold text-3xl text-center my-8">
      Création d'une annonce pour votre véhicule
    </h1>
    @form({
      route: 'vehicles.store',
      method: 'POST',
      enctype: 'multipart/form-data',
      class: 'bg-white shadow p-4 mb-8',
    })
      <div class="grid gap-6 mb-6 lg:grid-cols-2">
        <div>
          @field.root({ name: 'model' })
            @!field.label({ text: 'Modèle', class: 'label' })
            @!input.control({
              type: 'text',
              class: 'input-field',
              placeholder: 'Votre modèle',
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'type' })
            @!field.label({ text: 'Type', class: 'label' })
            @!select.control({
              options: types.map((type) => ({ name: type.name, value: type.id })),
              required: true,
              prompt: 'Choisissez un type',
              class: 'select',
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'price' })
            @!field.label({ text: 'Prix', class: 'label' })
            @!input.control({
              type: 'number',
              step: '0.10',
              class: 'input-field',
              placeholder: 'Prix de la location par jour (en €)',
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'year' })
            @!field.label({ text: 'Année', class: 'label' })
            @!input.control({
              type: 'number',
              step: '1',
              class: 'input-field',
              placeholder: 'Année de fabrication',
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'length' })
            @!field.label({ text: 'Longueur', class: 'label' })
            @!input.control({
              type: 'number',
              class: 'input-field',
              placeholder: 'Longueur du véhicule en mètres',
              step: '0.1',
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'height' })
            @!field.label({ text: 'Hauteur', class: 'label' })
            @!input.control({
              type: 'number',
              class: 'input-field',
              placeholder: 'Hauteur du véhicule en mètres',
              step: '0.1',
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'width' })
            @!field.label({ text: 'Largeur', class: 'label' })
            @!input.control({
              type: 'number',
              class: 'input-field',
              placeholder: 'Largeur du véhicule en mètres',
              step: '0.1',
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'km' })
            @!field.label({ text: 'Km', class: 'label' })
            @!input.control({
              type: 'number',
              class: 'input-field',
              placeholder: 'Nombre de kilomètres',
              step: '0.1',
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'city' })
            @!field.label({ text: 'Ville', class: 'label' })
            @!input.control({
              type: 'text',
              class: 'input-field',
              placeholder: 'Localisation du véhicule',
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'cleanWater' })
            @!field.label({ text: 'Eaux claires', class: 'label' })
            @!input.control({
              type: 'number',
              class: 'input-field',
              placeholder: "Nombre de litres d'eaux claires",
              step: 1,
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'wasteWater' })
            @!field.label({ text: 'Eaux usées', class: 'label' })
            @!input.control({
              type: 'number',
              class: 'input-field',
              placeholder: "Nombre de litres d'eaux usées",
              step: 1,
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'seats' })
            @!field.label({ text: 'Sièges', class: 'label' })
            @!input.control({
              type: 'number',
              class: 'input-field',
              placeholder: 'Nombre de places assises',
              step: 1,
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'beds' })
            @!field.label({ text: 'Couchages', class: 'label' })
            @!input.control({
              type: 'number',
              class: 'input-field',
              placeholder: 'Nombre de places de couchages',
              step: 1,
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'animals' })
            @!field.label({ text: 'Animaux autorisés', class: 'label' })
            @!select.control({
              class: 'select',
              prompt: 'Choisissez Oui ou Non',
              options: [
                {
                  name: 'Oui',
                  value: 1,
                },
                {
                  name: 'Non',
                  value: 0,
                },
              ],
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'travelAbroad' })
            @!field.label({ text: "Voyages à l'étranger", class: 'label' })
            @!select.control({
              class: 'select',
              prompt: 'Choisissez Oui ou Non',
              options: [
                {
                  name: 'Oui',
                  value: 1,
                },
                {
                  name: 'Non',
                  value: 0,
                },
              ],
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'description' })
            @!field.label({ text: 'Description', class: 'label' })
            @!textarea.control({
              rows: 4,
              placeholder: 'Description du véhicule...',
              class: 'textarea',
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
        <div>
          @field.root({ name: 'pictures[]' })
            @!field.label({ text: 'Photos', class: 'label' })
            @!input.control({
              type: 'file',
              class: 'input-file',
              multiple: true,
            })
            @!field.error({ class: 'text-sm text-red-500 mt-3' })
          @end
        </div>
      </div>
      @!button({
        text: 'Créer une annonce',
        type: 'submit',
        class:
          'focus:outline-none text-white bg-yellow-400 hover:bg-yellow-500 focus:ring-4 focus:ring-yellow-300 font-medium rounded-lg text-sm px-5 py-2.5 mr-2 mb-2',
      })
    @end
  </section>
@end

@email.layout()
  <p>Bonjour {{ user.firstName }},</p>
  <p>
    Vous avez demandé à réinitialiser le mot de passe de votre compte. Ce lien est valable 1 heure et ne peut servir qu'une seule fois.
  </p>
  <p>
    <a
      href="{{ urlFor('password_reset.edit', { token }, { prefixUrl: appUrl }) }}"
      style="display:inline-block;background:#E8930C;color:#1F2434;font-weight:bold;padding:10px 18px;border-radius:6px;text-decoration:none;"
    >
      Choisir un nouveau mot de passe
    </a>
  </p>
  <p style="color:#5A6070;font-size:14px;">
    Si vous n'êtes pas à l'origine de cette demande, ignorez ce message : votre mot de passe reste inchangé.
  </p>
@end

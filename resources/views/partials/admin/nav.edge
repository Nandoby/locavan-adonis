@let(url = request.url())
<nav aria-label="alternative nav">
  <div
    class="bg-gray-800 shadow-xl h-20 fixed bottom-0 mt-12 md:relative md:h-full md:min-h-screen z-10 w-full md:w-48 content-center"
  >
    <div
      class="md:mt-12 md:w-48 md:fixed md:left-0 md:top-0 content-center md:content-start text-left justify-between"
    >
      <ul
        class="list-reset flex flex-row md:flex-col pt-3 md:py-3 px-1 md:px-2 text-center md:text-left"
      >
        <li class="mr-3 flex-1">
          @link({
            route: 'admin.users',
            class: `block py-1 md:py-3 pl-1 align-middle text-white no-underline hover:text-white border-b-2 hover:border-pink-500 cursor-pointer ${url === '/admin/users' ? 'border-pink-500' : ' border-gray-800'}`,
          })
            <i class="fas fa-user pr-0 md:pr-3"></i>
            <span
              class="pb-1 md:pb-0 text-xs md:text-base text-gray-400 md:text-gray-200 block md:inline-block"
            >
              Utilisateurs
            </span>
          @end
        </li>
        <li class="mr-3 flex-1">
          @link({
            route: 'admin.vehicles',
            class: `block py-1 md:py-3 pl-1 align-middle text-white no-underline hover:text-white border-b-2 hover:border-indigo-500 cursor-pointer ${url === '/admin/vehicles' ? 'border-indigo-500' : 'border-gray-800'}`,
          })
            <i class="fa-regular fa-book-open pr-0 md:pr-3"></i>
            <span
              class="pb-1 md:pb-0 text-xs md:text-base text-gray-400 md:text-gray-200 block md:inline-block"
            >
              Annonces
            </span>
          @end
        </li>
        <li class="mr-3 flex-1">
          @link({
            route: 'admin.comments',
            class: `block py-1 md:py-3 pl-1 align-middle text-white no-underline hover:text-white border-b-2 hover:border-blue-500 cursor-pointer ${url === '/admin/comments' ? 'border-blue-500' : 'border-gray-800'}`,
          })
            <i class="fas fa-chart-area pr-0 md:pr-3"></i>
            <span
              class="pb-1 md:pb-0 text-xs md:text-base text-gray-400 md:text-gray-200 block md:inline-block"
            >
              Commentaires
            </span>
          @end
        </li>
      </ul>
    </div>
  </div>
</nav>
